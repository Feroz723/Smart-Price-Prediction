modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "ocl-icd", "opencl-headers", "openjpeg", "pkg-config", "qhull", "tcl", "tk", "zlib", "gcc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ML Demo"

[[workflows.workflow]]
name = "ML Demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python demo.py"

[workflows.workflow.metadata]
outputType = "console"
